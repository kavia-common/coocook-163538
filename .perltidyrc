##############################################################################
# ATTENTION: If you edit this file, please change .editorconfig accordingly! #
##############################################################################

--character-encoding=utf8
--variable-maximum-line-length
--maximum-line-length=100

--delete-interbracket-arrows
--delete-trailing-commas
--space-signature-paren=2
--valign-wide-equals
--want-trailing-commas=b
