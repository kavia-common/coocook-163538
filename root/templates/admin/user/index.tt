[% title = "Users" %]

[% WRAPPER table length=users.size %]
<thead>
    <tr class="sticky-top">
        <th>Name</th>
        <th>Admin Comment</th>
        <th>Owned projects</th>
        <th>Registered</th>
        <th>Status</th>
    </tr>
</thead>
<tbody>
[% FOR u IN users %]
    <tr>
        <td>[% link_user(u) %]</td>
        <td>[% u.admin_comment | html %]</td>
        <td style="text-align:center">[% u.projects_count %]</td>
        <td>[% u.created %]</td>
        <td>[% u.status %]</td>
    </tr>
[% END %]
</tbody>
[% END %]
