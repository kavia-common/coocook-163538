[% title = "Articles" %]

[% new = BLOCK %]
<p><a class="btn btn-primary" href="[% new_url %]"><i class="material-icons">add</i>&thinsp;New article</a></p>
[% END; new %]

<table class="table">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Comment</th>
            <th scope="col">Preorder in advance</th>
            <th scope="col">Shelf Life</th>
            <th scope="col">Shop Section</th>
            <th scope="col">Units</th>
            <th scope="col">Tags</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
[% FOR article IN articles %]
        <tr class="parent">
            <td><a href="[% article.edit_url %]">[% article.name | html %]</a></td>
            <td>[% article.comment | html %]</td>
            <td>[% IF article.preorder_workdays.defined AND article.preorder_servings.defined; article.preorder_workdays %] days if ≥[% article.preorder_servings %] servings[% END %]</td>
            <td>[% IF article.shelf_life_days.defined; article.shelf_life_days _ ' days'; ELSE; '<em>unknown</em>'; END %]</td>
            <td>[% IF article.shop_section; article.shop_section.name | html; END %]</td>
            <td>[% FOR u IN article.units; display_unit(u, {html=>1}); ' '; END %]</td>
            <td>[% article.tags_joined %]</td>
            <td>
            [% IF article.delete_url %]
                <form method="post" action="[% article.delete_url %]" class="action-btn">
                    <button class="btn btn-outline-danger btn-sm" type="submit" title="Delete [% article.name | html %]">
                        <i class="material-icons">delete_forever</i>
                    </button>
                </form>
            [% ELSE %]
                <button class="btn btn-outline-danger btn-sm btn-quad action-btn" disabled title="This article is used in dishes/recipes" style="pointer-events:auto;cursor:default">
                    <i class="material-icons">delete_forever</i>
                </button>
            [% END %]
            </td>
        </tr>
[% END %]
    </tbody>
</table>

[% new %]

[% WRAPPER includes/infobox.tt %]
    <em>Articles</em> are everything that can be sourced for preparing food.
    They might be products like apples, materials like water or tools like a whisk.
</p>

<p>
    <i class="material-icons">lightbulb</i> Pro tip:
    Optional details like preferred units, known shelf life or shop section
    are helpful when using articles in recipes/dishes and purchase lists.
[% END %]
