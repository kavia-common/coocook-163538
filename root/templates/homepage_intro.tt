<section>
    <div class="px-4 mb-5">
        <p>[% name %] is a web application for collecting recipes and making food plans. You can &hellip;</p>
    </div>
    <div class="content-box mb-5">
        <div class="d-flex justify-content-around flex-column flex-sm-row align-items-center gap-3">
            <div class="d-flex flex-column gap-3 text-center">
                <i class="material-icons fs-1">menu_book</i>
                <span>collect recipes</span>
            </div>
            <i class="material-icons d-none d-sm-block">east</i>
            <i class="material-icons d-block d-sm-none">south</i>
