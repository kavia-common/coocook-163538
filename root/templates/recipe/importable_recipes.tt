[% title = "Import recipe" %]

[% IF recipes.size == 0 %]
<p>No recipes to import</p>
[% ELSE %]
<ul class="list-group">
[% FOR recipe IN recipes %]
    <li class="list-group-item d-flex gap-3 justify-content-between align-items-center parent">
        <div>
            <a href="[% recipe.url %]">[% recipe.name | html %]</a>
            from [% link_project(recipe.project) %]
            by [% link_user(recipe.project.owner) %]
        </div>
        [% IF recipe.import_url %]
        <form method="get" action="[% recipe.import_url %]" class="action-btn">
            <button type="submit" title="Import this recipe into project &quot;[% project.name | html %]&quot;" class="btn btn-primary">
                <i class="material-icons">east</i>&thinsp;Import
            </button>
        </form>
        [% END %]
    </li>
[% END %]
</ul>
[% END %]
